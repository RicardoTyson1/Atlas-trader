# Copy to .env and fill in. NEVER commit .env.
# TradeLocker login (the same one you use on the TradeLocker web platform)
TL_EMAIL=
TL_PASSWORD=
# Server name shown on the TradeLocker login screen (e.g. the broker/prop server)
TL_SERVER=
# The account ID shown in TradeLocker (e.g. 2594596). Required so the bot
# can never pick the wrong (live) account.
TL_ACCOUNT_ID=
# Optional alternative: accNum (the small index number)
TL_ACC_NUM=

# Shared secret that TradingView alerts must include (any long random string)
WEBHOOK_SECRET=

# Optional notifications (leave blank to only log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
