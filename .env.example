# Copy to .env and fill in. NEVER commit .env.
# TradeLocker login (the same one you use on the TradeLocker web platform)
TL_EMAIL=
TL_PASSWORD=
# Server name shown on the TradeLocker login screen (e.g. the broker/prop server)
TL_SERVER=
# Optional: pick a specific account number if you have several
TL_ACC_NUM=

# Shared secret that TradingView alerts must include (any long random string)
WEBHOOK_SECRET=

# Optional notifications (leave blank to only log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
