# systemd unit for running Atlas 24/7 on a Linux VPS.
# Install: sudo cp deploy/atlas.service /etc/systemd/system/ && sudo systemctl enable --now atlas
[Unit]
Description=Atlas Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlas
WorkingDirectory=/opt/atlas-trader
ExecStart=/opt/atlas-trader/.venv/bin/atlas run --mode demo --webhook
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
